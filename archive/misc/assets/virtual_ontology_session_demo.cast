[113.584453, "o", "       \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   standard_cost_per_unit, 2) as margin_per_unit, SUM(scrap_units_produced)   \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[1;25r\u001b[24;1H\u001b[38;2;87;105;247m│\u001b[39m    as total_scrap_units, SUM(scrap_units_produced * sale_price_per_unit)     \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;1H\u001b[1;24r\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   as revenue_loss, SUM(scrap_units_produced * standard_cost_per_unit) as     \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   material_waste, ROUND(100.0 * SUM(scrap_units_produced) /                  \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   (SUM(good_units_produced) + SUM(scrap_units_produced)), 2) as scrap_rate   \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m    FROM mes_data WHERE machine_status = \\\"Running\\\" GROUP BY product_name,   \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m    sale_price_per_unit, standard_cost_per_unit ORDER BY revenue_l"]
