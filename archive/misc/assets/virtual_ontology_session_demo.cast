[31.300524, "o", "\u001b[?2026h\u001b[11d\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[2B\u001b[K\u001b[2B\u001b[K\r\n\u001b[K\r\n\u001b[K\r\n\u001b[K\u001b[10A\u001b[38;2;102;102;102m⏺\u001b[39m \u001b[1mBash\u001b(B\u001b[m(echo '{\"sql\": \"SELECT AVG(oee_score) as avg_oee, MIN(oee_score) as\r\n      min_oee, MAX(oee_score) as max_oee, SUM(CASE WHEN machine_status =\r\n      \\\"Stopped\\\" THEN 5 ELSE 0…)\r\n  ⎿  \u001b[38;2;102;102;102mRunning…\u001b[16;1H\u001b(B\u001b[m\u001b[38;2;215;119;87m✳\u001b[39m \u001b[38;2;215;119;87mImagining… \u001b(B\u001b[m\u001b[38;2;102;102;102m(11s · ⚒\u001b[39m \u001b[38;2;102;102;102m306 tokens · \u001b[1mesc \u001b(B\u001b[m\u001b[38;2;102;102;102mto interrupt)\u001b[18;1H\u001b(B\u001b[m\u001b[38;2;153;153;153m\u001b[2m╭──────────────────────────────────────────────────────────────────────────────╮\u001b[19;1H│\u001b(B\u001b[m\u001b[38;2;102;102;102m > \u001b[39m\u001b[7m \u001b(B\u001b[m                                                                          \u001b[38;2;153;153;153m\u001b[2m│\u001b[20;1H\u001b(B\u001b[m\u001b[?2026l"]
