[127.632676, "o", "k)\r\n\u001b[K\r\n\u001b[K\u001b[38;2;102;102;102m⏺\u001b[39m\r\u001b[2S\u001b[22;2H \u001b[1mBash\u001b(B\u001b[m(echo '{\"sql\": \"SELECT equipment_type, downtime_reason,\r\n      AVG(quality_score) as avg_quality, AVG(performance_score) as\u001b[K\r\n      avg_performance, COUNT(*) as occurrences FRO\u001b[K…\u001b[24;80H\n\u001b[23;52H)\r\n  \u001b[K⎿  \u001b[38;2;102;102;102mRunning…\u001b[39m\r\u001b[2S\u001b[A\u001b[K\r\n\u001b[K\u001b[38;2;87;105;247m╭──────────────\u001b[1;25r\u001b[24;16H\u001b(B\u001b[m\u001b[38;2;87;105;247m────────────────────────────────────────────────────────────────╮\u001b[39m\u001b[24;1H\u001b[1;24r\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m \u001b[38;2;87;105;247m\u001b[1mBash command\u001b(B\u001b[m                                                                 \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m                                                                              \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   echo '{\"sql\": \"SELECT"]
[127.632893, "o", " equipment_type, downtime_reason,                     \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   AVG(quality_score) as avg_quality, AVG(performance_score) as               \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   avg_performance, COUNT(*) as occurrences FROM mes_data WHERE               \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   machine_status = \\\"Stopped\\\" AND downtime_reason IS NOT NULL GROUP BY      \u001b[38;2;87;105;247m│\u001b[24;1H\u001b[1;25r\u001b[24;1H\u001b(B\u001b[m\u001b[?2026h\u001b[1;24r\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   equipment_type, downtime_reason HAVING COUNT(*) > 50 ORDER BY              \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   equipment_type, occurrences DESC\"}' > /tmp/query.json && ./query-log.sh    \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   POST /query -d @/tmp/query.json                                            \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   \u001b[38;2;"]
