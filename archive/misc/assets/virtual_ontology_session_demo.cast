[148.451692, "o", "\u001b[m  \u001b[K⎿  ☒\u001b[24;80H\n\u001b[23;7H \u001b[9mAnalyze scrap patterns by equipment type and product\u001b(B\u001b[m          \r\n     \u001b[K\u001b[38;2;44;122;57m☒\u001b[39m\u001b[24;80H\n\u001b[23;7H\u001b[38;2;44;122;57m \u001b[9mIdentify root causes and correlations with operational factors\r\n\u001b(B\u001b[m     \u001b[K☒\u001b[24;80H\n\u001b[23;7H \u001b[9mCalculate financial impact by product and equipment\r\n\u001b(B\u001b[m     \u001b[K\u001b[38;2;87;105;247m\u001b[1m☐\u001b(B\u001b[m\u001b[24;80H\n\u001b[23;7H\u001b[38;2;87;105;247m\u001b[1m Find temporal patterns (shifts, time of day, day of week)\r\n\u001b(B\u001b[m     \u001b[K☐\r\u001b[2S\u001b[22;7H Develop targeted improvement recommendations with ROI\r\n\u001b[K\r\n\u001b[K\u001b[38;2;102;102;102m⏺\u001b[39m \u001b[1mBash\u001b(B\u001b[m(ech\u001b[1;25r\u001b[24;11H\u001b[?2026l\u001b[?2026h\u001b[1;24r\u001b[1;1H\u001b[2S\u001b[22;11Ho '{\"sql\": \"SELECT CAST(strftime(\\\"%H\\\", timestamp) AS INTEGER) /\r\n       8 as shift, CASE WHEN CAST(strftime(\\\"%H\\\", timestamp) AS INTEGER) /\u001b[K\r\n       8 = 0 THEN \\\"Night (11\u001b[K…\u001b[24;80H\n\u001b[23;31H)\r\n  \u001b[K⎿  \u001b[38;2;102;102;102mRunning…\u001b[39m\r\u001b[2S\u001b[A\u001b[K\r\n\u001b[K\u001b[38;2;87;105;247m╭──────────────────────"]
[148.452168, "o", "────────────────────────────────────────────────────────╮\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m \u001b[38;2;87;105;247m\u001b[1mBash command\u001b(B\u001b[m                                                                 \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m                                                                              \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   echo '{\"sql\": \"SELECT CAST(strftime(\\\"%H\\\", timestamp) AS INTEGER) / 8     \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   as shift, CASE WHEN CAST(strftime(\\\"%H\\\", timestamp) AS INTEGER) / 8 = 0   \u001b[1;25r\u001b[24;80H\u001b[?2026l\u001b[38;2;87;105;247m│\u001b[39m\u001b[24;1H\u001b[1;24r\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m    THEN \\\"Night (11pm-7am)\\\" WHEN CAST(strftime(\\\"%H\\\", timestamp) AS        \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   INTEGER) / 8 = 1 THEN \\\"Day "]
[148.452306, "o", "(7am-3pm)\\\" ELSE \\\"Evening (3pm-11pm)\\\" END    \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   as shift_name, SUM(scrap_units_produced) as total_scrap,                   \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   SUM(good_units_produced) as total_good, ROUND(100.0 *                      \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   SUM(scrap_units_produced) / (SUM(good_units_produced) +                    \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   SUM(scrap_units_produced)), 2) as scrap_rate, SUM(scrap_units_produced *   \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m    sale_price_per_unit) as scrap_value FROM mes_data WHERE machine_status    \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   = \\\"Running\\\" GROUP BY shift ORDER BY shift\"}\u001b[1;25r\u001b[24;50H' > /tmp/query.json &&        \u001b[38;2;87;105;247m│\u001b[39m\u001b[24;1H\u001b[1;24r\u001b[24;80H\n\r\u001b[K\u001b[38;2;87;105;247m│\u001b[39m   ./query-log.sh POST /q"]
